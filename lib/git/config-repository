#!/bin/bash

cd "$(pwd)"

echo "Nome de usuário do Git (ex: John Doe):"
read -e git_user_name

echo "Email do usuário do Git (ex: john.doe@example.com):"
read -e git_user_email

git config user.name "$git_user_name"

git config user.email "$git_user_email"

echo "Deseja habilitar a assinatura GPG para commits? (s/n):"

read -e is_gpgsign

if [ "$is_gpgsign" = "s" ]; then
    git config commit.gpgsign true
fi
