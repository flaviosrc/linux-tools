#!/bin/bash

cleanup() {
	echo "[INFO] excluindo arquivo temporário da chave privada $tmp"
	[ -e $tmp ] && rm -f "$tmp"
}

trap 'cleanup' INT TERM EXIT

echo "
[INFO] script para adicionar chave privada que expira em 1h ou no término da sessão
"

tmp=$(mktemp) && chmod 600 "$tmp"

echo "Cole o conteúdo da chave privada aqui e termine pressionando Ctrl‑D"
cat > "$tmp"

ssh-add -t 1h "$tmp" || { echo "[ERROR] falha ao carregar a chave privada"; exit 1; }

exit 0
