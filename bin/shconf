#!/usr/bin/env bash

ROOT_DIR="$(dirname $(dirname $(realpath $0)))"
LIB_DIR="$ROOT_DIR/lib"

if [[ "$1" == "__complete" ]]; then
    find "$LIB_DIR" -maxdepth 1 -type f -printf '%f\n'
    exit 0
fi

SCRIPT_NAME="$1"
shift

SCRIPT_PATH="$LIB_DIR/$SCRIPT_NAME"

if [[ -x "$SCRIPT_PATH" ]]; then
    exec "$SCRIPT_PATH" "$@"
fi

echo "Unknown command: $SCRIPT_NAME"
exit 1
